#!/usr/bin/env bash
# Entrypoint for httpd-devcloud: write the runtime settings Apache reads (docroot, FastCGI backend,
# ServerName, project overrides, basic auth) to conf/devcloud-runtime.conf, then run httpd in the
# foreground as PID 1. Extra arguments go to httpd, e.g. `httpd-foreground -t`.
set -euo pipefail

log() { if [[ "${DEBUG:-0}" != "0" ]]; then printf '%s | %s\n' "$(date +'%F %T')" "$*" >&2; fi; }

CONF_DIR=/usr/local/apache2/conf
RUNTIME_CONF="${CONF_DIR}/devcloud-runtime.conf"
HTPASSWD=/usr/local/apache2/htpasswd
TLS_CERT="${CONF_DIR}/server.crt"
TLS_KEY="${CONF_DIR}/server.key"
PROJECT_ROOT=/var/www

# Apache gets grumpy about PID files pre-existing
rm -f /usr/local/apache2/logs/httpd.pid

# A self-signed certificate for :443, made per container (a key baked into a public image would be
# everyone's). TLS for the outside world terminates in front of the pod. An image built FROM this
# one can ship its own pair.
if [[ ! -s "${TLS_CERT}" || ! -s "${TLS_KEY}" ]]; then
  if ! out="$(umask 077; openssl req -batch -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
    -noenc -sha256 -days 3650 -subj /CN=localhost -addext subjectAltName=DNS:localhost,IP:127.0.0.1 \
    -keyout "${TLS_KEY}" -out "${TLS_CERT}" 2>&1)"; then
    printf 'error: generating the self-signed certificate failed:\n%s\n' "${out}" >&2
    exit 1
  fi
  chmod 0644 "${TLS_CERT}"
  log "generated a self-signed certificate"
fi

define() { # name [value]: one Define line; values go inside double quotes
  if [[ "${2-}" == *[\"\\$'\n']* ]]; then
    printf 'error: %s must not contain a double quote, backslash or newline\n' "$1" >&2
    exit 1
  fi
  if [[ $# -eq 1 ]]; then printf 'Define %s\n' "$1"; else printf 'Define %s "%s"\n' "$1" "$2"; fi
}

# DocumentRoot: APACHE_DOCUMENTROOT, then DOCROOT (relative paths are under /var/www).
docroot="${APACHE_DOCUMENTROOT:-${DOCROOT:-${PROJECT_ROOT}/docroot}}"
[[ "${docroot}" == /* ]] || docroot="${PROJECT_ROOT}/${docroot}"
[[ "${docroot}" == / ]] || docroot="${docroot%/}"

overrides="${APACHE_OVERRIDES_DIR:-}"
overrides="${overrides%/}"

{
  echo '# Generated by httpd-foreground at container start; edits are lost on restart.'
  define APACHE_DOCUMENTROOT "${docroot}"
  define APACHE_FCGI_HOST_PORT "${APACHE_FCGI_HOST_PORT:-127.0.0.1:9000}"
  define APACHE_SERVERNAME "${APACHE_SERVERNAME:-${HOSTNAME:-localhost}}"

  # Project overrides, from the directory in APACHE_OVERRIDES_DIR (none when it is unset):
  #   httpd-vhost-overrides.conf  included last inside the :80 and :443 vhosts
  #   httpd-vhosts.conf           included at server level, for extra vhosts
  # Apache includes them from where they are, so a graceful restart picks up edits.
  if [[ -z "${overrides}" ]]; then
    echo "notice: APACHE_OVERRIDES_DIR is not set; no project Apache overrides applied" >&2
  elif [[ ! -d "${overrides}" ]]; then
    echo "notice: APACHE_OVERRIDES_DIR ${overrides} is not a directory; no project Apache overrides applied" >&2
  else
    define APACHE_OVERRIDES
    define APACHE_OVERRIDES_DIR "${overrides}"
    for f in httpd-vhost-overrides.conf httpd-vhosts.conf; do
      if [[ -f "${overrides}/${f}" ]]; then log "including ${overrides}/${f}"; fi
    done
  fi

  # Basic auth. The password reaches htpasswd on stdin and is never logged.
  rm -f "${HTPASSWD}"
  if [[ -n "${APACHE_BASIC_AUTH_USER:-}" && -n "${APACHE_BASIC_AUTH_PASS:-}" ]]; then
    printf '%s\n' "${APACHE_BASIC_AUTH_PASS}" | htpasswd -ciB "${HTPASSWD}" "${APACHE_BASIC_AUTH_USER}" 2>/dev/null
    chown root:www-data "${HTPASSWD}"
    chmod 0640 "${HTPASSWD}"
    echo "basic auth enabled for user ${APACHE_BASIC_AUTH_USER}" >&2
    define BasicAuth
  fi
} > "${RUNTIME_CONF}.tmp"
mv "${RUNTIME_CONF}.tmp" "${RUNTIME_CONF}"
log "DocumentRoot ${docroot}"

exec httpd -DFOREGROUND "$@"
